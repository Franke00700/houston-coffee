# PostgreSQL runtime connection. Use a least-privilege application role in production.
DATABASE_URL=postgresql://houston_app:change-me@localhost:5432/houston_coffee
# Direct/migration connection; may equal DATABASE_URL for local development.
DIRECT_URL=postgresql://houston_owner:change-me@localhost:5432/houston_coffee
SESSION_COOKIE_SECURE=false
SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=24
TRUSTED_ORIGIN=http://localhost:3000
# Accept X-Forwarded-For only behind a trusted proxy that replaces this header.
TRUST_PROXY=false
# The built-in bounded rate limiter supports exactly one Node process.
# Keep this at 1 until an atomic shared rate-limit store is implemented.
WEB_CONCURRENCY=1
# Public order attempts allowed per process in a 10-minute window.
ORDER_RATE_LIMIT=10
# Storage is intentionally local in development; configure an object store before production uploads.
UPLOAD_DIR=./uploads
